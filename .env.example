# Core
APP_SECRET=change_me_in_production_to_a_long_random_string
APP_BASE_URL=http://localhost:8080
APP_NAME=DocNest
DEBUG=false

# Storage
DOCS_ROOT=/data/docs
THUMBS_ROOT=/data/thumbs
PREVIEWS_ROOT=/data/previews
MAX_UPLOAD_MB=1024

# Postgres
PG_HOST=postgres
PG_PORT=5432
PG_DB=docnest
PG_USER=docnest
PG_PASSWORD=docnest
PG_SSLMODE=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Vector Store
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=docnest_chunks

# OCR
OCR_ENGINE=paddleocr
OCR_LANGS=ch,en
OCR_PAGE_PARALLELISM=2

# LLM (summarize/RAG)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://ollama:11434

# For OpenAI-compatible providers (optional)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_api_key_here

# For DeepSeek (optional)
# DEEPSEEK_API_KEY=your_deepseek_key_here

# Embedding
EMBED_PROVIDER=local_service
EMBED_MODEL=BAAI/bge-m3
EMBED_NORMALIZE=true
EMBED_CHUNK_TOKENS=512
EMBED_CHUNK_OVERLAP=64

# Processing
THUMBNAIL_MAX_WIDTH=600
THUMBNAIL_FORMAT=webp
PREVIEW_DPI=150

# Worker (Celery)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
